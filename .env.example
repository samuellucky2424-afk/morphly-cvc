VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
